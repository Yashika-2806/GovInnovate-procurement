# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EXPLAIN_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Groq API Key (Primary - fastest inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_EXPLAIN_MODEL=qwen/qwen3.8-27b

# Database Configuration (PostgreSQL + pgvector or local fallback)
# If PostgreSQL is not reachable, the system automatically uses SQLite + ChromaDB locally
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ps_finder
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/ps_finder.db
CHROMA_PERSIST_DIR=./data/chroma

# Scheduling Configuration
DAILY_DISCOVERY_ENABLED=true
DAILY_MONITORING_ENABLED=true
MONITORING_INTERVAL_HOURS=24
DISCOVERY_INTERVAL_HOURS=24

# Server Config
HOST=0.0.0.0
PORT=8000
